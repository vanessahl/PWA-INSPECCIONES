{
  "name": "pwa-inspecciones-laboratorio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node tests/starter.spec.mjs && tsx tests/manifest.spec.ts && tsx tests/service-worker.spec.ts && tsx tests/offline.spec.ts && tsx tests/rendering.spec.ts && tsx tests/sync.spec.ts && tsx tests/capabilities.spec.ts",
    "test:unit": "tsx --test --test-reporter=spec tests/unit/conflict-policy.test.ts tests/unit/schema.test.ts tests/unit/queue.test.ts",
    "test:integration": "tsx --test --test-reporter=spec tests/integration/sync-route.test.ts tests/integration/offline-sync.test.ts",
    "test:e2e": "tsx --test --test-reporter=spec tests/e2e/critical-flow.test.ts tests/e2e/rendering-live.test.ts",
    "test:all": "npm test && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
